# Terrace 35 — Apache config for Hostinger shared hosting.
# Upload alongside index.html in public_html.

# ---------------------------------------------------------------------------
# Caching
#
# The host's default was `max-age=604800` on everything, which meant an updated
# stylesheet kept showing the old design to returning visitors for a week.
# Split the difference: content that gets overwritten in place is revalidated
# every time, and content with a unique filename is cached hard.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # HTML: never trust a cached copy. Always check with the server.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # CSS and JS: overwritten in place on each deploy. They also carry a ?v=
  # string in the markup, but this is the belt to that pair of braces.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Fonts, images and the logo ship under unique names and never change
  # in place, so they can be cached for a year.
  <FilesMatch "\.(woff2|woff|ttf|otf|webp|jpg|jpeg|png|gif|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # XML feeds change with the site.
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ---------------------------------------------------------------------------
# Correct MIME types — some shared hosts still miss these, which silently
# breaks webfonts and WebP.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
</IfModule>

# ---------------------------------------------------------------------------
# Canonical host and HTTPS: one address, so link equity and analytics do not
# split across www/non-www and http/https.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# Keep the lead-webhook source out of public view.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteRule ^lead-webhook/ - [F,L]
</IfModule>

ErrorDocument 404 /index.html
